{
  "name": "remotion-story-producer",
  "version": "0.1.0",
  "description": "Narration-led, story-beat-driven Remotion production system.",
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@remotion/cli": "4.0.489",
    "@remotion/effects": "4.0.489",
    "@remotion/gif": "4.0.489",
    "@remotion/google-fonts": "4.0.489",
    "@remotion/layout-utils": "4.0.489",
    "@remotion/light-leaks": "4.0.489",
    "@remotion/lottie": "4.0.489",
    "@remotion/media": "4.0.489",
    "@remotion/motion-blur": "4.0.489",
    "@remotion/paths": "4.0.489",
    "@remotion/renderer": "4.0.489",
    "@remotion/shapes": "4.0.489",
    "@remotion/tailwind-v4": "4.0.489",
    "@remotion/three": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "lottie-web": "5.13.0",
    "ogl": "1.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.489",
    "three": "0.185.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@remotion/eslint-config-flat": "4.0.489",
    "@types/node": "20.12.14",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "predev": "npm run registry:generate",
    "build": "remotion bundle",
    "prebuild": "npm run registry:generate",
    "upgrade": "remotion upgrade",
    "test": "node --import tsx --test tests/contracts/*.test.ts tests/catalog/*.test.ts tests/docs/*.test.ts tests/external-references/*.test.ts tests/scene-package/*.test.ts tests/renderer-registry/*.test.ts tests/narration/*.test.ts tests/runtime/*.test.ts tests/runtime/*.test.tsx tests/projects/*.test.ts tests/projects/*.test.tsx tests/registry/*.test.ts tests/registry/*.test.tsx tests/baseline/*.test.ts tests/project-check/*.test.ts tests/final-assembly/*.test.ts tests/m6-proof/*.test.ts tests/m7-gps/*.test.ts tests/m7-gps/*.test.tsx tests/m8-gps/*.test.ts tests/m8-gps/*.test.tsx tests/m9-product/*.test.ts tests/m9-product/*.test.tsx",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "narration:generate": "node --import tsx scripts/narration/cli.ts generate",
    "narration:seal": "node --import tsx scripts/narration/cli.ts seal",
    "narration:check": "node --import tsx scripts/narration/cli.ts check",
    "registry:generate": "node --import tsx scripts/registry/cli.ts generate",
    "registry:check": "node --import tsx scripts/registry/cli.ts check",
    "catalog:generate": "node --import tsx scripts/catalog/cli.ts generate",
    "catalog:check": "node --import tsx scripts/catalog/cli.ts check",
    "catalog:query": "node --import tsx scripts/catalog/cli.ts query",
    "docs:check-links": "node --import tsx scripts/docs/check-links.ts",
    "reference:sync": "node --import tsx scripts/external-references/cli.ts sync",
    "reference:localize": "node --import tsx scripts/external-references/cli.ts localize",
    "scene:package": "node --import tsx scripts/scene-package/cli.ts package",
    "scene:coverage": "node --import tsx scripts/scene-package/cli.ts coverage",
    "renderer:generate": "node --import tsx scripts/renderer-registry/cli.ts generate",
    "renderer:check": "node --import tsx scripts/renderer-registry/cli.ts check",
    "m6:proof:generate": "node --import tsx scripts/m6-proof/generate.ts write",
    "m6:proof:check": "node --import tsx scripts/m6-proof/generate.ts check",
    "m6:proof:compositions": "npm run m6:proof:check && remotion compositions src/remotion/proofs/m6-scene-runtime/index.ts",
    "m6:proof:still": "npm run m6:proof:check && remotion still src/remotion/proofs/m6-scene-runtime/index.ts M6SceneRuntimeProof out/m6-scene-runtime-proof/frame-72.png --frame=72 --log=error",
    "m6:proof:render": "npm run m6:proof:check && remotion render src/remotion/proofs/m6-scene-runtime/index.ts M6SceneRuntimeProof out/m6-scene-runtime-proof/proof.mp4 --codec=h264 --log=error",
    "m6:proof:evidence": "npm run m6:proof:still && npm run m6:proof:render && node --import tsx scripts/m6-proof/evidence.ts check",
    "m6:proof:evidence:write": "npm run m6:proof:still && npm run m6:proof:render && node --import tsx scripts/m6-proof/evidence.ts write",
    "m7:gps:audio": "node --import tsx scripts/m7-gps/generate-local-audio.ts",
    "m7:gps:freeze": "node --import tsx scripts/m7-gps/freeze-inputs.ts",
    "m7:gps:author": "node --import tsx scripts/m7-gps/author-scenes.ts",
    "m7:gps:authoring:compositions": "node --import tsx scripts/m7-gps/author-scenes.ts compositions",
    "m7:gps:authoring:stills": "node --import tsx scripts/m7-gps/author-scenes.ts stills",
    "m7:gps:evidence": "node --import tsx scripts/m7-gps/evidence.ts check",
    "m7:gps:evidence:write": "node --import tsx scripts/m7-gps/evidence.ts write",
    "m8:gps:audio": "node --import tsx scripts/m8-gps/generate-global-audio.ts",
    "m8:gps:freeze": "node --import tsx scripts/m8-gps/freeze-inputs.ts",
    "m8:gps:media": "node --import tsx scripts/m8-gps/evidence.ts render",
    "m8:gps:evidence:write": "node --import tsx scripts/m8-gps/evidence.ts write",
    "m8:gps:evidence": "node --import tsx scripts/m8-gps/evidence.ts check",
    "m8:gps:approval:write": "node --import tsx scripts/m8-gps/approval.ts write explicit-user-current-preview",
    "m8:gps:approval": "node --import tsx scripts/m8-gps/approval.ts check",
    "m9:product:scene-audio": "node --import tsx scripts/m9-product/scene-audio.ts",
    "m9:product:audio": "node --import tsx scripts/m9-product/global-audio.ts",
    "m9:product:scene-evidence": "node --import tsx scripts/m9-product/scene-evidence.ts check",
    "m9:product:evidence": "node --import tsx scripts/m9-product/final-evidence.ts check",
    "m9:product:approval:write": "node --import tsx scripts/m9-product/approval.ts write explicit-user-current-preview",
    "m9:product:approval": "node --import tsx scripts/m9-product/approval.ts check",
    "baseline:evidence": "node --import tsx scripts/baseline/evidence.ts",
    "project:check": "node --import tsx scripts/project-check/cli.ts",
    "final:assembly": "node --import tsx scripts/final-assembly/cli.ts",
    "production:start": "node --import tsx scripts/production/cli.ts start",
    "production:status": "node --import tsx scripts/production/cli.ts status",
    "production:narrative": "node --import tsx scripts/production/cli.ts narrative",
    "production:scene:freeze": "node --import tsx scripts/production/cli.ts scene-freeze",
    "compositions": "remotion compositions src/index.ts",
    "precompositions": "npm run registry:generate",
    "check": "npm run test && npm run typecheck && npm run lint && npm run docs:check-links && npm run catalog:check && npm run registry:check && npm run build && npm run compositions && env -u RSP_VOXCPM_PRIVATE_CONFIG npm run project:check -- --project gps-relativity --level narrative && npm run m7:gps:freeze -- check && npm run m7:gps:evidence && npm run m8:gps:audio -- check && npm run m8:gps:freeze -- check && npm run final:assembly -- --project gps-relativity --check && npm run m8:gps:evidence && npm run m8:gps:approval && npm run project:check -- --project gps-relativity --level final && npm run m9:product:scene-audio -- check && npm run m9:product:audio -- check && npm run m9:product:scene-evidence && npm run final:assembly -- --project product-comic-vertical --check && npm run m9:product:evidence && npm run m9:product:approval && npm run project:check -- --project product-comic-vertical --level final"
  },
  "sideEffects": [
    "*.css"
  ]
}
