  "captionCues": [
    {
      "chunkId": "stress-cycle",
      "endFrame": 257,
      "meaningId": "square-corner-stress",
      "startFrame": 12,
      "text": "客舱加压会让机身在每次起降中反复膨胀和收缩，窗框也要承受一轮又一轮的载荷变化。"
    },
    {
      "chunkId": "sharp-corner",
      "endFrame": 569,
      "meaningId": "square-corner-stress",
      "startFrame": 257,
      "text": "如果窗口保留方形尖角，应力会在角点集中，微小裂纹更容易从那里开始，并在疲劳循环中扩展。"
    },
    {
      "chunkId": "smooth-load-path",
      "endFrame": 834,
      "meaningId": "rounded-load-path",
      "startFrame": 580,
      "text": "圆角把载荷沿平滑曲线分散到更大的结构范围，避免力量突然挤在一个尖点上。"
    },
    {
      "chunkId": "durable-window",
      "endFrame": 1084,
      "meaningId": "rounded-load-path",
      "startFrame": 834,
      "text": "所以飞机窗户采用圆润轮廓，不只是为了外观，而是为了降低疲劳裂纹风险，让机身更耐久。"
    }
  ],
