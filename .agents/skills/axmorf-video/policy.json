{
  "schemaVersion": 19,
  "policyVersion": "axmorf-video-policy-v24",
  "rootEndpoints": [
    "project-production-complete",
    "project-production-current"
  ],
  "privateConfigPath": "private/producer.config.json",
  "executionPreferencesPath": "private/execution-preferences.json",
  "requiredEntrypointHeadings": [
    "Create the Project when needed",
    "Load optional Agent capabilities",
    "Resolve Agent execution",
    "Inspect before cost",
    "Prepare content-addressed tasks",
    "Execute dirty Agent tasks",
    "Hand off to fixed continuation",
    "Preserve production invariants",
    "Classify failure by task owner",
    "Finish with verified delivery"
  ],
  "requiredReferences": [
    "references/producer-config.md",
    "references/direct-production-workflow.md",
    "references/execution-capabilities.md",
    "references/scene-agent-orchestration.md",
    "references/global-visual-agent-orchestration.md",
    "references/cover-agent-orchestration.md",
    "references/task-execution-protocol.md",
    "references/project-revision.md",
    "references/agent-rework-and-system-hardening.md"
  ],
  "workflowCommands": [
    "project:create",
    "project:originality:freeze",
    "project:revise:context",
    "project:revise:validate",
    "project:revise",
    "project:revision:promote",
    "project:execution:resolve",
    "project:produce:inspect",
    "project:produce:prepare",
    "project:task:bind",
    "project:task:describe",
    "project:task:finalize",
    "project:task:check",
    "project:task:commit",
    "project:task:fail",
    "project:task:file-read",
    "project:task:file-write",
    "project:attempt:recover-inspect",
    "project:attempt:reissue",
    "project:produce:continue"
  ],
  "executionPolicy": {
    "resolutionPhase": "before-production-inspect",
    "precedence": [
      "user-prompt",
      "settings-page",
      "builtin-default"
    ],
    "promptOverridePersistence": "current-production-only-unless-explicit-save",
    "defaultMode": "subagents",
    "defaultSubagentMaxConcurrency": 4,
    "repositoryMaxConcurrency": 4,
    "unknownRuntimeMaxConcurrency": 0,
    "inlinePolicy": "root-sequential-one-workspace-at-a-time",
    "subagentPolicy": "bounded-native-wait-any-or-synchronous-batch",
    "subagentWorkerTransport": "verified-shared-workspace-or-controller-io",
    "unverifiedWorkerTransportPolicy": "block-before-prepare",
    "exactCapacityFailurePolicy": "block-before-prepare",
    "automaticModeFallback": false,
    "identityVisibility": "none"
  },
  "optionalCapabilitySlots": {
    "externalAssetAcquisition": {
      "slotVersion": "external-asset-acquisition-agent-slot-v1",
      "owner": "root-agent",
      "activation": "current-agent-exposes-import-compatible-mcp-tools",
      "phase": "after-project-create-before-production-inspect",
      "absencePolicy": "omit-without-error-or-placeholder",
      "admissionBoundary": "project-asset-import-receipt",
      "downstreamVisibility": "none"
    }
  },
  "invariants": {
    "productionAuthority": "production-revision-task-dag-artifact-attestation",
    "executionAttemptRole": "diagnostics-only",
    "sceneAuthoringOwner": "resolved-root-or-one-runtime-native-child",
    "rootAgentRole": "resolved-executor-or-dispatcher-with-event-driven-supervision",
    "sceneAuthoringSkill": "repository-local-remotion-best-practices",
    "globalVisualAuthoringOwner": "resolved-root-or-one-runtime-native-child",
    "coverAuthoringOwner": "resolved-root-or-one-runtime-native-child",
    "delegationSurface": "optional-runtime-native-subagents",
    "sharedCheckout": true,
    "capacityPolicy": "resolved-bounded-pool-max-four",
    "unavailableDelegationPolicy": "unknown-or-zero-capacity-blocks",
    "rootAgentAuthorsTaskOutputs": "only-when-resolved-inline",
    "taskExecutionContract": "immutable-attempt-neutral-agent-task-input",
    "agentWriteBoundary": "declared-task-outputs-only-after-successful-attempt-bound-bind",
    "taskBindingPolicy": "zero-write-before-task-worker-bound",
    "controllerIoPolicy": "strict-bound-file-read-write-only",
    "artifactAuthority": "validated-artifact-attestation",
    "artifactReusePolicy": "reuse-valid-content-addressed-artifacts",
    "artifactPromotionPolicy": "validator-only-atomic-promotion",
    "rootWaitsForAllChildTerminalStates": false,
    "rootPostDispatchParticipation": "event-driven-diagnosis-and-bounded-task-recovery",
    "fixedContinuationMonitorsTaskEvents": true,
    "fixedContinuationClaimPolicy": "one-shot-atomic-exact-attempt",
    "fixedContinuationEventSource": "immutable-attempt-event-log",
    "fixedContinuationTimeoutMs": 3600000,
    "fixedContinuationDeadlineOrigin": "execution-attempt-created-at",
    "convergePolicy": "fixed-exactly-once-after-all-agent-artifacts",
    "agentFailurePolicy": "terminal-exit-without-converge",
    "fixedFailurePolicy": "terminal-exit-root-diagnosis-and-report-only",
    "failedAttemptRecoveryPolicy": "bounded-task-fault-inspect-then-same-revision-zero-provider-reissue",
    "projectRevisionBasePolicy": "exact-current-revision-and-verified-four-file-delivery",
    "projectRevisionCandidatePolicy": "isolated-source-public-narration-work-attempt-output-delivery",
    "projectRevisionPromotionPolicy": "automatic-after-candidate-delivery-with-independent-explicit-retry",
    "projectRevisionRollbackPolicy": "restore-previous-current-project-and-delivery",
    "globalVisualReadsSceneOutputs": false,
    "coverReadsOnlyTaskInputs": true,
    "childIdentityPersisted": false,
    "timingPolicy": "pcm-cumulative-ceil-v1",
    "storyBeatContract": "discriminated-narrated-or-silent-scene",
    "configuredSceneTemplates": "project-create-copy-with-project-local-instance",
    "templateCopyPolicy": "fixed-task-artifact-without-agent",
    "silentSceneNarrationPolicy": "no-tts-no-captions-fixed-preset-frames",
    "deliveryPolicy": "synchronous-exact-four-file-controlled-promotion",
    "deliveryCompletionAuthority": "checksum-probe-eof-validated-current-package"
  },
  "forbiddenActions": [
    "user-task-thread-api",
    "task-worktree",
    "automatic-inline-dirty-task-fallback",
    "root-task-artifact-fabrication",
    "repeat-converge-in-one-attempt",
    "root-child-status-polling",
    "root-direct-converge",
    "persist-child-identity",
    "trust-chat-as-artifact-authority",
    "edit-artifact-store-manifest",
    "git add .",
    "push",
    "publish",
    "agent-write-outside-task-workspace",
    "unbound-task-read-or-write",
    "root-unchanged-progress-reasoning",
    "automatic-program-source-repair",
    "recovery-with-live-previous-workers",
    "unbounded-task-recovery"
  ],
  "contextBudgets": {
    "entrypointMaxWords": 580,
    "directWorkflowMaxWords": 680,
    "projectRevisionMaxWords": 220,
    "normalProductionMaxWords": 1900,
    "normalProductionMaxCharacters": 18000,
    "sceneOrchestrationMaxWords": 330,
    "globalVisualOrchestrationMaxWords": 270,
    "coverOrchestrationMaxWords": 240
  },
  "supervisionPolicy": {
    "normalWait": "original-handle-blocking-wait-or-native-notification",
    "normalTimeout": "renew-original-wait-only",
    "waitDuration": "longest-blocking-wait-within-host-deadline",
    "diagnosticTrigger": "error-notification",
    "taskRepairOwner": "original-bound-executor-before-terminal",
    "automaticRecoveryScope": "proven-agent-authored-output-fault-only",
    "automaticRecoveryLimitPerUserRequest": 1,
    "recoveryQuiescence": "original-continuation-and-all-previous-workers-exited",
    "recoveryGate": "attempt-recovery-ready",
    "recoveryWorkers": "fresh-bound-workers",
    "unknownFixedExternalFaults": "diagnose-and-report-only",
    "duplicateSuccessNotifications": "ignore-after-fixed-result-report"
  }
}
