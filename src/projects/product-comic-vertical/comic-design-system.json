    "band": {
      "top": 1490,
      "bottom": 1810
    },
    "visualExclusionZone": {
      "top": 1470,
      "bottom": 1830
    }
  },
  "grammar": {
    "devices": [
      "panel",
      "gutter",
      "speed-line",
      "screentone",
      "impact-frame",
      "ink-outline",
      "evidence-stamp"
    ],
    "maxSimultaneousPanels": 3,
    "automaticLayout": false,
    "sceneDsl": false,
    "automaticDirector": false
  }
}
