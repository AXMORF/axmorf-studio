{
  "algorithmId": "pcm-cumulative-ceil-v1",
  "captionCues": [
    {
      "chunkId": "three-layers-01",
      "endFrame": 156,
      "meaningId": "three-layers",
      "startFrame": 12,
      "text": "算法、模型和 AI 系统，常被混在一起说。"
    },
    {
      "chunkId": "three-layers-02",
      "endFrame": 253,
      "meaningId": "three-layers",
      "startFrame": 162,
      "text": "但它们其实是三层不同的东西。"
    },
    {
      "chunkId": "algorithm-rules-01",
      "endFrame": 378,
      "meaningId": "algorithm-rules",
      "startFrame": 253,
      "text": "算法，是一套解决问题的步骤和规则。"
    },
    {
      "chunkId": "algorithm-rules-02",
      "endFrame": 522,
      "meaningId": "algorithm-rules",
      "startFrame": 378,
      "text": "比如排序算法，规定先比较什么，再交换什么。"
    },
    {
      "chunkId": "model-learns-01",
      "endFrame": 647,
      "meaningId": "model-learns",
      "startFrame": 522,
      "text": "模型，是从数据中学到的参数结构。"
    },
    {
      "chunkId": "model-learns-02",
      "endFrame": 786,
      "meaningId": "model-learns",
      "startFrame": 647,
      "text": "算法负责怎么学，模型保存学到了什么。"
    },
    {
      "chunkId": "system-operates-01",
      "endFrame": 901,
      "meaningId": "system-operates",
      "startFrame": 786,
      "text": "AI 系统，则把模型放进真实流程。"
    },
    {
      "chunkId": "system-operates-02",
      "endFrame": 1064,
      "meaningId": "system-operates",
      "startFrame": 901,
      "text": "它还包含数据、工具、权限、监控和人类反馈。"
    },
    {
      "chunkId": "whole-picture-01",
      "endFrame": 1203,
      "meaningId": "whole-picture",
      "startFrame": 1064,
      "text": "把算法看成训练方法，模型看成训练后的大脑。"
    },
    {
      "chunkId": "whole-picture-02",
      "endFrame": 1328,
      "meaningId": "whole-picture",
      "startFrame": 1203,
      "text": "AI 系统，就是让它真正工作的整套组织。"
    },
    {
      "chunkId": "whole-picture-03",
      "endFrame": 1492,
      "meaningId": "whole-picture",
      "startFrame": 1334,
      "text": "模型提供智能核心，系统决定它能否可靠地产生价值。"
    }
  ],
