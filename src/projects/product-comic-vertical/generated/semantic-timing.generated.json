{
  "algorithmId": "pcm-cumulative-ceil-v1",
  "captionCues": [
    {
      "chunkId": "problem-hook-01",
      "endFrame": 303,
      "meaningId": "problem-hook",
      "startFrame": 15,
      "text": "完整视频不只是画面。故事、旁白、镜头、声音与审核，必须对应。"
    },
    {
      "chunkId": "problem-hook-02",
      "endFrame": 572,
      "meaningId": "problem-hook",
      "startFrame": 303,
      "text": "输入一变，旧字幕、旧镜头和旧预览就可能失效；难点是守住作品身份。"
    },
    {
      "chunkId": "problem-friction-01",
      "endFrame": 892,
      "meaningId": "problem-friction",
      "startFrame": 580,
      "text": "先猜时长，Scene 与字幕就追着波形移动；近似引用，也证明不了准确来源。"
    },
    {
      "chunkId": "problem-friction-02",
      "endFrame": 1074,
      "meaningId": "problem-friction",
      "startFrame": 892,
      "text": "没有 checksum 和审查记录，导出的视频也无法对应输入。"
    },
    {
      "chunkId": "product-reveal-01",
      "endFrame": 1309,
      "meaningId": "product-reveal",
      "startFrame": 1083,
      "text": "Remotion Story Producer，把这些环节连成证据绑定的代码生产链。"
    },
    {
      "chunkId": "core-capabilities-01",
      "endFrame": 1609,
      "meaningId": "core-capabilities",
      "startFrame": 1316,
      "text": "主题先写成四份规格。朗读单元按语义与节奏创作，不按标点切分。"
    },
    {
      "chunkId": "core-capabilities-02",
      "endFrame": 1806,
      "meaningId": "core-capabilities",
      "startFrame": 1609,
      "text": "声音生成后封存 PCM，以累计采样边界推导绝对帧。"
    },
    {
      "chunkId": "workflow-input-01",
      "endFrame": 2114,
      "meaningId": "workflow-input",
      "startFrame": 1816,
      "text": "流程从主题资料开始，先核对来源、可用事实、观众、时长与画幅。"
    },
    {
      "chunkId": "workflow-input-02",
      "endFrame": 2364,
      "meaningId": "workflow-input",
      "startFrame": 2114,
      "text": "再创作 StoryBeat 和 ttsChunks，选择声音并完成 StoryCheck。"
    },
    {
      "chunkId": "workflow-create-01",
      "endFrame": 2675,
      "meaningId": "workflow-create",
      "startFrame": 2373,
      "text": "VoxCPM 逐块生成候选。选中的 PCM 连同实测采样数和 checksum 封存。"
    },
    {
      "chunkId": "workflow-create-02",
      "endFrame": 2853,
      "meaningId": "workflow-create",
      "startFrame": 2675,
      "text": "外部参考绑定冻结来源、准确 demo、依赖闭包与 license。"
    },
    {
      "chunkId": "workflow-create-03",
      "endFrame": 3093,
      "meaningId": "workflow-create",
      "startFrame": 2853,
      "text": "Renderer 由静态 registry 绑定 Scene，不能改写旁白或吞帧。"
    },
    {
      "chunkId": "workflow-result-01",
      "endFrame": 3324,
      "meaningId": "workflow-result",
      "startFrame": 3103,
      "text": "成片之外，还交付媒体参数、完整解码与批量 review 证据。"
    },
    {
      "chunkId": "workflow-result-02",
      "endFrame": 3641,
      "meaningId": "workflow-result",
      "startFrame": 3324,
      "text": "GPS 已走完 M1 到 M8。五个 Scene、全局装配、用户批准与最终检查都可复核。"
    },
    {
      "chunkId": "differentiated-value-01",
      "endFrame": 3886,
      "meaningId": "differentiated-value",
      "startFrame": 3651,
      "text": "每个阶段都声明所有权和依赖；输入变化，旧证据就必须失效。"
    },
    {
      "chunkId": "differentiated-value-02",
      "endFrame": 4203,
      "meaningId": "differentiated-value",
      "startFrame": 3886,
      "text": "时间、引用和批准各有身份；渲染不调用 Agent、网络、Git 或目录扫描。"
    },
    {
      "chunkId": "proof-and-fit-01",
      "endFrame": 4452,
      "meaningId": "proof-and-fit",
      "startFrame": 4212,
      "text": "它适合把创作、工程和审查证据放进同一仓库的团队。"
    },
    {
      "chunkId": "proof-and-fit-02",
      "endFrame": 4692,
      "meaningId": "proof-and-fit",
      "startFrame": 4452,
      "text": "Agent 负责创作与校验，Scene 逐段制作，最终批准只由用户作出。"
    },
    {
      "chunkId": "call-to-action-01",
      "endFrame": 4885,
      "meaningId": "call-to-action",
      "startFrame": 4703,
      "text": "这样，视频不只是一次导出，而是能够继续验证的作品。"
    },
    {
      "chunkId": "call-to-action-02",
      "endFrame": 5101,
      "meaningId": "call-to-action",
      "startFrame": 4885,
      "text": "从一份主题资料开始，按这条可验证生产链完成第一支作品。"
    }
  ],
