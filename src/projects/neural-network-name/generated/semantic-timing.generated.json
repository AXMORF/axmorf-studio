  "captionCues": [
    {
      "chunkId": "name-origin-01",
      "endFrame": 188,
      "meaningId": "name-origin",
      "startFrame": 15,
      "text": "神经网络为什么叫神经网络？答案藏在它最初模仿的对象里。"
    },
    {
      "chunkId": "biological-neuron-01",
      "endFrame": 390,
      "meaningId": "biological-neuron",
      "startFrame": 188,
      "text": "生物神经元会接收许多信号，整合之后，再把信号传给其他神经元。"
    },
    {
      "chunkId": "artificial-neuron-01",
      "endFrame": 567,
      "meaningId": "artificial-neuron",
      "startFrame": 390,
      "text": "人工神经网络把这种关系简化成一组数字运算。"
    },
    {
      "chunkId": "artificial-neuron-02",
      "endFrame": 755,
      "meaningId": "artificial-neuron",
      "startFrame": 567,
      "text": "输入乘上权重，相加，再经过激活函数，得到新的输出。"
    },
    {
      "chunkId": "network-learning-01",
      "endFrame": 961,
      "meaningId": "network-learning",
      "startFrame": 755,
      "text": "许多人工神经元分层连接，就组成了网络。训练会不断调整连接的权重。"
    },
    {
      "chunkId": "analogy-limit-01",
      "endFrame": 1167,
      "meaningId": "analogy-limit",
      "startFrame": 961,
      "text": "所以，神经网络这个名字说的是结构灵感，而不是一颗装在电脑里的大脑。"
    }
  ],
