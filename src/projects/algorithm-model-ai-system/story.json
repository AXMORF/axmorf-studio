{
  "schemaVersion": 1,
  "storyId": "algorithm-model-ai-system",
  "title": "算法、模型和 AI 系统有什么区别？",
  "beats": [
    {
      "meaningId": "three-layers",
      "narrativePurpose": "提出常见混淆，并建立三层结构。",
      "ttsChunks": [
        {
          "chunkId": "three-layers-01",
          "ttsText": "算法、模型和 AI 系统，常被混在一起说。"
        },
        {
          "chunkId": "three-layers-02",
          "ttsText": "但它们其实是三层不同的东西。"
        }
      ],
      "explicitPauses": [
        {
          "afterChunkId": "three-layers-01",
          "pauseMs": 180
        }
      ]
    },
    {
      "meaningId": "algorithm-rules",
      "narrativePurpose": "定义算法是解决问题的步骤与规则。",
      "ttsChunks": [
        {
          "chunkId": "algorithm-rules-01",
          "ttsText": "算法，是一套解决问题的步骤和规则。"
        },
        {
          "chunkId": "algorithm-rules-02",
          "ttsText": "比如排序算法，规定先比较什么，再交换什么。"
        }
      ],
      "explicitPauses": []
    },
    {
      "meaningId": "model-learns",
      "narrativePurpose": "定义模型是训练后承载所学规律的参数结构。",
      "ttsChunks": [
        {
          "chunkId": "model-learns-01",
          "ttsText": "模型，是从数据中学到的参数结构。"
        },
        {
          "chunkId": "model-learns-02",
          "ttsText": "算法负责怎么学，模型保存学到了什么。"
        }
      ],
      "explicitPauses": []
    },
    {
      "meaningId": "system-operates",
      "narrativePurpose": "定义 AI 系统是让模型在真实流程中工作的完整组合。",
      "ttsChunks": [
        {
          "chunkId": "system-operates-01",
          "ttsText": "AI 系统，则把模型放进真实流程。"
        },
        {
          "chunkId": "system-operates-02",
          "ttsText": "它还包含数据、工具、权限、监控和人类反馈。"
        }
      ],
      "explicitPauses": []
    },
    {
      "meaningId": "whole-picture",
      "narrativePurpose": "用类比串联三层，并落到可靠价值的结论。",
      "ttsChunks": [
        {
          "chunkId": "whole-picture-01",
          "ttsText": "把算法看成训练方法，模型看成训练后的大脑。"
        },
        {
          "chunkId": "whole-picture-02",
          "ttsText": "AI 系统，就是让它真正工作的整套组织。"
        },
        {
          "chunkId": "whole-picture-03",
          "ttsText": "模型提供智能核心，系统决定它能否可靠地产生价值。"
        }
      ],
      "explicitPauses": [
        {
          "afterChunkId": "whole-picture-02",
          "pauseMs": 180
        }
      ]
    }
  ]
}
