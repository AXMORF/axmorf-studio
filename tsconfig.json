{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@axmorf/studio": [
        "packages/studio/src/index.ts"
      ],
      "@axmorf/studio/contracts": [
        "packages/studio/src/contracts/index.ts"
      ],
      "@axmorf/studio/remotion": [
        "packages/studio/src/remotion.ts"
      ]
    }
  },
  "exclude": [
    "remotion.config.ts",
    "build",
    "dist",
    ".desktop-package-resources",
    ".vite",
    "desktop",
    "packages/*/dist",
    "out",
    "src/projects/*"
  ]
}
