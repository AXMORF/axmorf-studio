{
  "algorithmId": "pcm-cumulative-ceil-v1",
  "captionCues": [
    {
      "chunkId": "position-is-time-01",
      "endFrame": 155,
      "meaningId": "position-is-time",
      "startFrame": 15,
      "text": "手机定位，表面上是在算位置，底层先是在比较时间。"
    },
    {
      "chunkId": "position-is-time-02",
      "endFrame": 361,
      "meaningId": "position-is-time",
      "startFrame": 155,
      "text": "GPS 接收机测量多颗卫星信号的到达时间，再把光速乘上时间差，换算成距离。"
    },
    {
      "chunkId": "two-relativistic-effects-01",
      "endFrame": 510,
      "meaningId": "two-relativistic-effects",
      "startFrame": 361,
      "text": "卫星高速运动，让它的钟按照狭义相对论每天慢大约七微秒。"
    },
    {
      "chunkId": "two-relativistic-effects-02",
      "endFrame": 687,
      "meaningId": "two-relativistic-effects",
      "startFrame": 510,
      "text": "但卫星所在位置引力更弱，广义相对论又让它的钟每天快大约四十五微秒。"
    },
    {
      "chunkId": "net-drift-01",
      "endFrame": 840,
      "meaningId": "net-drift",
      "startFrame": 696,
      "text": "两种效应合在一起，卫星钟相对地面每天大约快三十八微秒。"
    },
    {
      "chunkId": "net-drift-02",
      "endFrame": 1018,
      "meaningId": "net-drift",
      "startFrame": 840,
      "text": "这个数字听起来很小，可无线电信号每一微秒就能传播大约三百米。"
    },
    {
      "chunkId": "error-accumulation-01",
      "endFrame": 1152,
      "meaningId": "error-accumulation",
      "startFrame": 1018,
      "text": "如果系统不做校正，测距误差会迅速累积到公里量级。"
    },
    {
      "chunkId": "error-accumulation-02",
      "endFrame": 1421,
      "meaningId": "error-accumulation",
      "startFrame": 1152,
      "text": "导航依赖的不是一只孤立的钟，而是卫星、地面控制和接收机共享的一套精密时间基准。"
    },
    {
      "chunkId": "practical-conclusion-01",
      "endFrame": 1553,
      "meaningId": "practical-conclusion",
      "startFrame": 1433,
      "text": "所以，相对论不是只存在于黑板上的抽象理论。"
    },
    {
      "chunkId": "practical-conclusion-02",
      "endFrame": 1716,
      "meaningId": "practical-conclusion",
      "startFrame": 1553,
      "text": "每次手机把蓝点放到地图上，背后都有爱因斯坦的时间修正正在工作。"
    }
  ],
