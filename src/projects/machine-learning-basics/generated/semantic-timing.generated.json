{
  "algorithmId": "pcm-cumulative-ceil-v1",
  "captionCues": [
    {
      "chunkId": "not-human-thinking-01",
      "endFrame": 111,
      "meaningId": "not-human-thinking",
      "startFrame": 15,
      "text": "机器学习，不是让电脑真的学会思考。"
    },
    {
      "chunkId": "not-human-thinking-02",
      "endFrame": 255,
      "meaningId": "not-human-thinking",
      "startFrame": 111,
      "text": "它更像是让电脑从许多例子中，自己找出规律。"
    },
    {
      "chunkId": "rules-versus-examples-01",
      "endFrame": 409,
      "meaningId": "rules-versus-examples",
      "startFrame": 255,
      "text": "传统程序，是人先写好规则，再让电脑照着执行。"
    },
    {
      "chunkId": "rules-versus-examples-02",
      "endFrame": 563,
      "meaningId": "rules-versus-examples",
      "startFrame": 409,
      "text": "机器学习则是给电脑数据和答案，让它归纳规则。"
    },
    {
      "chunkId": "learn-with-cat-examples-01",
      "endFrame": 687,
      "meaningId": "learn-with-cat-examples",
      "startFrame": 563,
      "text": "比如识别猫，我们先给电脑看许多标好答案的图片。"
    },
    {
      "chunkId": "learn-with-cat-examples-02",
      "endFrame": 841,
      "meaningId": "learn-with-cat-examples",
      "startFrame": 687,
      "text": "它会逐渐抓住耳朵、轮廓和纹理等共同特征。"
    },
    {
      "chunkId": "training-model-prediction-01",
      "endFrame": 1033,
      "meaningId": "training-model-prediction",
      "startFrame": 841,
      "text": "反复看例子、调整参数、纠正错误，这个过程叫训练。"
    },
    {
      "chunkId": "training-model-prediction-02",
      "endFrame": 1163,
      "meaningId": "training-model-prediction",
      "startFrame": 1033,
      "text": "训练得到的规则集合，叫模型。"
    },
    {
      "chunkId": "training-model-prediction-03",
      "endFrame": 1302,
      "meaningId": "training-model-prediction",
      "startFrame": 1163,
      "text": "模型判断一张新图像像不像猫，这就叫预测。"
    },
    {
      "chunkId": "patterns-have-limits-01",
      "endFrame": 1446,
      "meaningId": "patterns-have-limits",
      "startFrame": 1302,
      "text": "但模型只会寻找数据里的模式，不会自动理解世界。"
    },
    {
      "chunkId": "patterns-have-limits-02",
      "endFrame": 1595,
      "meaningId": "patterns-have-limits",
      "startFrame": 1446,
      "text": "如果数据有偏差，预测结果也可能有偏差。"
    },
    {
      "chunkId": "patterns-have-limits-03",
      "endFrame": 1758,
      "meaningId": "patterns-have-limits",
      "startFrame": 1595,
      "text": "所以好数据、合适目标和持续验证，都很重要。"
    },
    {
      "chunkId": "one-sentence-summary-01",
      "endFrame": 1959,
      "meaningId": "one-sentence-summary",
      "startFrame": 1758,
      "text": "一句话，机器学习就是用数据训练模型，让电脑对新情况做出预测。"
    }
  ],
