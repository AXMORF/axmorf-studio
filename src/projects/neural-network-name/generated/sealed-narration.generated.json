      "localPath": "public/projects/neural-network-name/narration/2c1677d6e5be23d3a8a233872de1207af68725f2ab65d3c318dafe5a2593593b/chunks/biological-neuron-01.wav",
      "meaningId": "biological-neuron",
      "pcm": {
        "channelLayout": "mono",
        "sampleFormat": "s16le",
        "sampleRate": 48000
      },
      "sampleFrameCount": 322560,
      "ttsText": "生物神经元会接收许多信号，整合之后，再把信号传给其他神经元。"
    },
