{
  "name": "axmorf-studio",
  "version": "0.3.0-rc.2",
  "description": "Agent-first video production workspace and npm distribution for AXMORF Studio.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AXMORF/axmorf-studio.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/studio",
    "packages/create-axmorf-studio"
  ],
  "overrides": {
    "@remotion/eslint-config-flat": {
      "typescript-eslint": "8.48.0"
    },
    "fast-uri": "3.1.8",
    "nanoid": "3.3.18",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@remotion/cli": "4.0.489",
    "@remotion/effects": "4.0.489",
    "@remotion/gif": "4.0.489",
    "@remotion/google-fonts": "4.0.489",
    "@remotion/layout-utils": "4.0.489",
    "@remotion/light-leaks": "4.0.489",
    "@remotion/lottie": "4.0.489",
    "@remotion/media": "4.0.489",
    "@remotion/motion-blur": "4.0.489",
    "@remotion/paths": "4.0.489",
    "@remotion/renderer": "4.0.489",
    "@remotion/shapes": "4.0.489",
    "@remotion/tailwind-v4": "4.0.489",
    "@remotion/three": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "@speech-sdk/core": "0.27.0",
    "lottie-web": "5.13.0",
    "node-edge-tts": "1.2.11",
    "ogl": "1.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.489",
    "three": "0.185.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@remotion/eslint-config-flat": "4.0.489",
    "@types/node": "20.19.19",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "scripts": {
    "packages:build": "npm run build --workspaces --if-present",
    "packages:typecheck": "npm run typecheck --workspaces --if-present",
    "test:package-boundary": "node --import tsx --test tests/package-boundary/*.test.ts",
    "bootstrap": "node --import tsx scripts/bootstrap/cli.ts",
    "prepare": "npm run bootstrap",
    "dev": "node --import tsx scripts/dev/cli.ts",
    "predev": "npm run bootstrap",
    "dev:lan": "node --import tsx scripts/dev/cli.ts --lan",
    "predev:lan": "npm run bootstrap",
    "config:dev": "vite --config settings/vite.config.ts",
    "config:build": "vite build --config settings/vite.config.ts",
    "build": "remotion bundle",
    "prebuild": "npm run bootstrap",
    "upgrade": "remotion upgrade",
    "test": "node --import tsx scripts/tests/run-tests.ts",
    "pretest": "npm run bootstrap",
    "typecheck": "tsc --noEmit --pretty false",
    "pretypecheck": "npm run bootstrap",
    "lint": "eslint .",
    "prelint": "npm run bootstrap",
    "scene-template-audio:generate": "node --import tsx scripts/scene-templates/cli.ts generate",
    "scene-template-audio:check": "node --import tsx scripts/scene-templates/cli.ts check",
    "docs:check-links": "node --import tsx scripts/docs/check-links.ts",
    "compositions": "remotion compositions src/index.ts",
    "precompositions": "npm run bootstrap",
    "check:static": "npm run test && npm run typecheck && npm run lint && npm run docs:check-links && npm run scene-template-audio:check && npm run config:build && npm run build && npm --workspace create-axmorf-studio run check:package",
    "check:host": "npm run compositions",
    "check": "npm run check:static && npm run check:host",
    "release:prepare": "node --import tsx scripts/release/prepare-version.ts"
  },
  "sideEffects": [
    "*.css"
  ]
}
