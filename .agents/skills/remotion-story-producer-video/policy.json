{
  "schemaVersion": 7,
  "policyVersion": "remotion-story-producer-video-policy-v7",
  "rootEndpoint": "watcher-started-and-owners-dispatched",
  "backgroundEndpoint": "delivery-render-started",
  "privateConfigPath": "private/producer.config.json",
  "requiredEntrypointHeadings": [
    "Start directly",
    "Freeze inputs before dispatch",
    "Launch watcher and dispatch threads",
    "Keep context bounded",
    "Preserve production invariants",
    "Classify failure by owner",
    "Finish after dispatch"
  ],
  "requiredReferences": [
    "references/producer-config.md",
    "references/direct-production-workflow.md",
    "references/scene-agent-orchestration.md",
    "references/global-visual-agent-orchestration.md",
    "references/cover-agent-orchestration.md",
    "references/agent-rework-and-system-hardening.md"
  ],
  "workflowCommands": [
    "production:preflight",
    "production:start",
    "production:narrative",
    "production:scene:freeze",
    "delivery:cover:freeze",
    "production:watch:start",
    "production:scene:check",
    "production:owner:ready",
    "production:owner:failed"
  ],
  "invariants": {
    "sceneAuthoringOwner": "one-independent-thread-per-meaning-id",
    "sceneAuthoringSkill": "repository-local-remotion-best-practices",
    "sceneTaskInputProjection": "complete-assignment-task-input",
    "sceneOwnerValidation": "scene-check-ready-before-owner-ready",
    "sceneReadabilityAuthority": "assignment-readability-policy",
    "globalVisualAuthoringOwner": "one-independent-thread-per-story",
    "globalVisualDefaultRole": "minimal-style-aligned-background-board",
    "coverAuthoringOwner": "one-independent-thread-per-story",
    "threadCreationSurface": "create_thread",
    "sharedCheckout": true,
    "rootAgentAuthorsOwnerOutputs": false,
    "rootWaitsAfterDispatch": false,
    "repositoryMonitorsThreadLifecycle": false,
    "watcherInput": "assignment-bound-owner-receipts-only",
    "missingReceiptPolicy": "wait-without-timeout-retry-or-heartbeat",
    "globalVisualReadsSceneOutputs": false,
    "coverReadsOnlyAssignmentInputs": true,
    "coverMissingBlocksRenderReady": false,
    "coverMissingBlocksAutomaticDelivery": true,
    "centralWriter": "detached-repository-watcher-only",
    "threadIdentityPersisted": false,
    "timingPolicy": "pcm-cumulative-ceil-v1",
    "storyBeatContract": "discriminated-narrated-or-silent-scene",
    "defaultBookends": "explicit-reusable-intro-outro-scene-presets",
    "defaultBookendOwnerPolicy": "preauthored-check-and-receipt-only",
    "silentSceneNarrationPolicy": "no-tts-no-captions-fixed-preset-frames",
    "watcherLaunchPolicy": "detached-spawn-acknowledgement-v1",
    "watcherLaunchAmbiguityPolicy": "intent-without-receipt-never-retry",
    "deliveryLaunchPolicy": "detached-spawn-acknowledgement-v1",
    "deliveryLaunchAmbiguityPolicy": "intent-without-receipt-never-retry",
    "deliveryReadsRenderedMp4": false
  },
  "forbiddenActions": [
    "subagent-owner",
    "wait_threads",
    "read_thread",
    "git add .",
    "push",
    "publish",
    "monitor-detached-watcher",
    "monitor-detached-render",
    "hand-edit-derived-state"
  ],
  "contextBudgets": {
    "entrypointMaxWords": 450,
    "directWorkflowMaxWords": 500,
    "normalProductionMaxWords": 1500,
    "normalProductionMaxCharacters": 12000,
    "sceneOrchestrationMaxWords": 300,
    "globalVisualOrchestrationMaxWords": 250,
    "coverOrchestrationMaxWords": 220
  }
}
